# Active_Skillference manuscript configuration — annotated reference copy.
# Copy this to config.yaml and customize. It links the manuscript prose to the execution
# layer: loaded by `yaml.safe_load` inside `infrastructure/rendering/_pdf_combined_renderer.py`
# (manuscript metadata) and by the project's scripts (curriculum/experiment parameters and
# the provenance-resolved render hook `scripts/z_generate_manuscript_variables.py`).

# Consumed by: `infrastructure/rendering/pdf_renderer.py`
paper:
  # Follow the RASP standard: titles must be objective and descriptive
  title: "Your Project Title"
  subtitle: "Optional Subtitle"
  version: "1.0.0"
  date: ""  # Auto-generated by `infrastructure/validation/output/validator.py` if empty

book:
  title: "Your Project Title"
  subtitle: "Optional Subtitle"
  edition: "1.0.0"
  year: "2026"
  license: "MIT"
  code_license: "MIT"
  cover:
    image: "../figures/active_skillference_cover.png"

front_matter:
  page_two_visual:
    image: "../figures/active_skillference_skill_atlas.png"
    title: "Named Skill Atlas"
    caption: "All exported skill names are tokenized into a deterministic front-matter atlas; visible labels are readable representatives rather than a complete printed index."

# Consumed by: `infrastructure.publishing.extract_publication_metadata` (in `infrastructure/publishing/metadata.py`)
authors:
  - name: "Your Name"
    orcid: "0000-0000-0000-0000"  # Get from https://orcid.org/
    email: "your.email@institution.org"
    affiliation: "Your Institution"
    corresponding: true

# Optional: Multiple authors
#  - name: "Co-Author Name"
#    orcid: "0000-0000-0000-0000"
#    email: "coauthor@institution.org"
#    affiliation: "Co-Author Institution"
#    corresponding: false

# Release workflow (Zenodo + GitHub): reserve a DOI first (reserve-DOI-first), then fill
# the fields below. Leave DOIs blank while the project is unpublished — never carry an
# unminted identifier.
# Consumed by: `infrastructure.publishing.publish_to_zenodo` (in `infrastructure/publishing/platforms.py`)
publication:
  doi: ""  # Concept DOI — stable citation; PDF cover and CITATION.cff use this field only
  version_doi: ""  # Latest Zenodo version DOI; updated by publish_project_release.py
  version_record: ""  # https://zenodo.org/records/{id} for the latest deposit
  github_repository: ""  # e.g. owner/repo (set when a public repository exists)
  repository_url: ""  # e.g. https://github.com/owner/repo
  repository_label: "Source repository"
  transmission_bookends:
    enabled: false
    max_prior_releases: 5
    show_steganography: false
  deposit_filename:
    enabled: true
    topic: ""  # optional; default = first significant title word
  journal: ""
  volume: ""
  pages: ""
  year: ""

keywords:
  - "active inference"
  - "free energy principle"
  - "curriculum"

metadata:
  license: "MIT"
  language: "en"

# Disabled by default — enable only for confidential/secure publishing runs.
steganography:
  enabled: false
  overlays_enabled: false
  barcodes_enabled: false
  metadata_enabled: false
  hashing_enabled: false
  encryption_enabled: false
  overlay_mode: "text"
  overlay_text: ""

# Consumed by: `infrastructure.llm.LLMClient` (in `infrastructure/llm/core/client.py`)
llm:
  reviews:
    enabled: false  # Set to true to enable LLM-powered reviews
    types:
      - executive_summary  # Default
      # - quality_review
      # - methodology_review
  translations:
    enabled: false  # Set to true to enable automated translations
    languages:
      - zh  # Default: Chinese Simplified

# Consumed by: `infrastructure/reporting/pipeline_report_model.py` and CI/CD gates
testing:
  max_test_failures: 0
  max_infra_test_failures: 0
  max_project_test_failures: 0
